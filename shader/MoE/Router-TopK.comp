#version 450
#define TS 256
#define TOPK 8
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable

layout(local_size_x = TS, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint M;
    uint N;
    uint K;
    uint slots;
} dims;

layout(set = 0, binding = 0) readonly restrict buffer Act { vec4 x[]; };
layout(set = 0, binding = 1) readonly restrict buffer Gamma { vec4 gamma[]; };
layout(set = 0, binding = 2) readonly restrict buffer RouterW { uvec4 w[]; };
layout(set = 0, binding = 3) readonly restrict buffer SharedGateW { uvec4 sgw[]; };
layout(set = 0, binding = 4) writeonly restrict buffer Ids { uint ids[]; };
layout(set = 0, binding = 5) writeonly restrict buffer Weights { float weights[]; };
layout(set = 0, binding = 6) writeonly restrict buffer SharedW { float sharedW[]; };
layout(set = 0, binding = 7) writeonly restrict buffer Xn { vec4 xn[]; };

const float EPSILON = 1e-6;

shared vec4 xCache[512];
shared float probs[256];
shared float sgPart[256];
shared float subSums[8];

void main() {
    uint m = gl_WorkGroupID.x;
    uint e = gl_LocalInvocationID.x;
    uint kvec = dims.K / 4;

    float sumSq = 0.0;
    for (uint i = e; i < kvec; i += TS) {
        vec4 v = x[m * kvec + i];
        xCache[i] = v;
        sumSq += dot(v, v);
    }
    sumSq = subgroupAdd(sumSq);
    if (subgroupElect()) subSums[gl_SubgroupID] = sumSq;
    barrier();
    float invRms;
    if (e == 0) {
        float total = 0.0;
        uint groups = (TS + gl_SubgroupSize - 1) / gl_SubgroupSize;
        for (uint i = 0; i < groups; i++) total += subSums[i];
        subSums[0] = inversesqrt(total / float(dims.K) + EPSILON);
    }
    barrier();
    invRms = subSums[0];

    for (uint i = e; i < kvec; i += TS) {
        vec4 nv = xCache[i] * gamma[i] * invRms;
        xCache[i] = nv;
        xn[m * kvec + i] = nv;
    }
    barrier();

    if (e < dims.N) {
        float acc = 0.0;
        uint base = e;
        for (uint g = 0; g < dims.K / 8; g++) {
            uvec4 raw = w[base];
            acc += dot(xCache[g * 2], vec4(unpackHalf2x16(raw.x), unpackHalf2x16(raw.y)));
            acc += dot(xCache[g * 2 + 1], vec4(unpackHalf2x16(raw.z), unpackHalf2x16(raw.w)));
            base += dims.N;
        }
        probs[e] = acc;
    }

    sgPart[e] = 0.0;
    for (uint g = e; g < dims.K / 8; g += TS) {
        uvec4 raw = sgw[g];
        sgPart[e] += dot(xCache[g * 2], vec4(unpackHalf2x16(raw.x), unpackHalf2x16(raw.y)));
        sgPart[e] += dot(xCache[g * 2 + 1], vec4(unpackHalf2x16(raw.z), unpackHalf2x16(raw.w)));
    }
    barrier();

    if (e == 0) {
        float mx = probs[0];
        for (uint i = 1; i < dims.N; i++) if (probs[i] > mx) mx = probs[i];
        for (uint i = 0; i < dims.N; i++) probs[i] = exp(probs[i] - mx);
        float selProb[TOPK];
        uint selIdx[TOPK];
        float selSum = 0.0;
        for (uint s = 0; s < TOPK; s++) {
            uint best = 0;
            for (uint i = 1; i < dims.N; i++) if (probs[i] > probs[best]) best = i;
            selIdx[s] = best;
            selProb[s] = probs[best];
            selSum += probs[best];
            probs[best] = -1.0;
        }
        for (uint s = 0; s < TOPK; s++) {
            ids[m * dims.slots + s] = selIdx[s];
            weights[m * dims.slots + s] = selProb[s] / selSum;
        }
        float sg = 0.0;
        for (uint i = 0; i < TS; i++) sg += sgPart[i];
        sharedW[m] = 1.0 / (1.0 + exp(-sg));
    }
}
