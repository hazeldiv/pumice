#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_shader_atomic_float : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_8bit_storage : require
#define TS 256
#define vec 4
layout(constant_id = 0) const int d_model = 4096;

layout(local_size_x = TS, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Dimensions {
    uint M;
    uint N;
    uint K;
    uint gOffset;
    uint kOffset;
    uint vOffset;
    uint maxCtx;
    uint headDim;
    uint rotaryDim;
} param;

const float EPSILON = 1e-6;

layout(set = 0, binding = 0) buffer DataBuffer { vec4 x[]; };
layout(set = 0, binding = 1) readonly buffer GammaBuffer { vec4 gamma[]; };
layout(set = 0, binding = 2) readonly buffer weightBuffer { uvec4 w[]; };
layout(set = 0, binding = 3) readonly restrict buffer MatrixD { vec4 scale[]; };
layout(set = 0, binding = 4) readonly restrict buffer MatrixE { vec4 zeroPoint[]; };
layout(set = 0, binding = 5) readonly buffer thetaBuffer { float theta[]; };
layout(set = 0, binding = 6) buffer qOutBuffer { float qOut[]; };
layout(set = 0, binding = 7) buffer kCacheBuffer { uint8_t kCache[]; };
layout(set = 0, binding = 8) buffer vCacheBuffer { uint8_t vCache[]; };
layout(set = 0, binding = 9) buffer kScaleBuffer { float kScale[]; };
layout(set = 0, binding = 10) buffer kZeroBuffer { float kZero[]; };
layout(set = 0, binding = 11) buffer vScaleBuffer { float vScale[]; };
layout(set = 0, binding = 12) buffer vZeroBuffer { float vZero[]; };
layout(set = 0, binding = 13) buffer PositionBuffer { uint position[]; };
layout(set = 0, binding = 14) readonly buffer qGammaBuffer { float qGamma[]; };
layout(set = 0, binding = 15) readonly buffer kGammaBuffer { float kGamma[]; };
layout(set = 0, binding = 16) buffer gAttnBuffer { float gAttn[]; };

shared float shared_sum;
shared vec4 cache[d_model/vec];
shared vec4 scaleCache[d_model/vec];
shared vec4 zeroCache[d_model/vec];
shared float sub_sums[(TS + 31) / 32];
shared float acc_shared[TS];
shared float rope_shared[TS];
shared float shared_sum2;
shared float val_shared[TS];
shared float qscale_sh;
shared float qzero_sh;

const uvec4 lowShifts  = uvec4(0, 4, 8, 12);
const uvec4 highShifts = uvec4(16, 20, 24, 28);

vec4 unpackInt4x4(uint packedComponent, uvec4 shiftOffsets) {
    return vec4(uvec4(packedComponent) >> shiftOffsets & uvec4(0xF));
}

void quantizeParams(float v) {
    uint i = gl_LocalInvocationID.x;
    val_shared[i] = v;
    barrier();
    if (i == 0) {
        float mn = val_shared[0];
        float mx = val_shared[0];
        for (uint j = 1; j < TS; j++) {
            mn = min(mn, val_shared[j]);
            mx = max(mx, val_shared[j]);
        }
        qscale_sh = (mx - mn) / 255.0;
        if (qscale_sh == 0.0) qscale_sh = 1.0;
        qzero_sh = -mn;
    }
    barrier();
}

uint quantize(float v) {
    float q = (v + qzero_sh) / qscale_sh;
    int qi = int(round(q));
    if (qi < 0) qi = 0;
    if (qi > 255) qi = 255;
    return uint(qi);
}

void main() {
    uint col = gl_LocalInvocationID.x;
    uint globalCol = gl_WorkGroupID.x*TS + col;
    uint pos = position[0];
    uint HEAD_DIM = param.headDim;
    uint ROTARY_DIM = param.rotaryDim;
    uint ROTARY_HALF = ROTARY_DIM / 2u;
    if (globalCol >= param.N) return;

    uint scaleIdx = gl_WorkGroupID.x * param.K / vec;
    float sum_sq = 0.0;

    for (uint t = 0; t < param.K/vec; t+=TS) {
        uint idx = t + col;
        vec4 val = x[idx];
        cache[idx] = val * gamma[idx];
        scaleCache[idx] = scale[idx + scaleIdx];
        zeroCache[idx] = zeroPoint[idx + scaleIdx];
        sum_sq += dot(val, val);
    }

    sum_sq = subgroupAdd(sum_sq);
    if (subgroupElect()) {
        sub_sums[gl_SubgroupID] = sum_sq;
    }
    barrier();

    if (gl_LocalInvocationID.x == 0) {
        float final_sum = 0.0;
        uint active_subgroups = (TS + gl_SubgroupSize - 1) / gl_SubgroupSize;
        for (uint i = 0; i < active_subgroups; i++) {
            final_sum += sub_sums[i];
        }
        shared_sum = final_sum;
    }
    barrier();
    float rms = sqrt((shared_sum / float(d_model)) + EPSILON);
    float inv_rms = 1.0 / rms;

    float acc = 0.0;
    uint baseRow = 0;
    #pragma unroll
    for (uint k=0;k<param.K/vec; k+=8) {
        uvec4 rawInput = w[baseRow + globalCol];
        vec4 w0 = unpackInt4x4(rawInput.x, lowShifts) * scaleCache[k] - zeroCache[k];
        vec4 w1 = unpackInt4x4(rawInput.x, highShifts) * scaleCache[k+1] - zeroCache[k+1];
        vec4 w2 = unpackInt4x4(rawInput.y, lowShifts) * scaleCache[k+2] - zeroCache[k+2];
        vec4 w3 = unpackInt4x4(rawInput.y, highShifts) * scaleCache[k+3] - zeroCache[k+3];
        vec4 w4 = unpackInt4x4(rawInput.z, lowShifts) * scaleCache[k+4] - zeroCache[k+4];
        vec4 w5 = unpackInt4x4(rawInput.z, highShifts) * scaleCache[k+5] - zeroCache[k+5];
        vec4 w6 = unpackInt4x4(rawInput.w, lowShifts) * scaleCache[k+6] - zeroCache[k+6];
        vec4 w7 = unpackInt4x4(rawInput.w, highShifts) * scaleCache[k+7] - zeroCache[k+7];
        acc += dot(cache[k] * inv_rms, w0);
        acc += dot(cache[k+1] * inv_rms, w1);
        acc += dot(cache[k+2] * inv_rms, w2);
        acc += dot(cache[k+3] * inv_rms, w3);
        acc += dot(cache[k+4] * inv_rms, w4);
        acc += dot(cache[k+5] * inv_rms, w5);
        acc += dot(cache[k+6] * inv_rms, w6);
        acc += dot(cache[k+7] * inv_rms, w7);
        baseRow += param.N;
    }

    uint cacheSlot = pos * (param.vOffset - param.kOffset);

    if (globalCol >= param.gOffset && globalCol < param.kOffset) {
        gAttn[globalCol - param.gOffset] = acc;
        return;
    }

    if (globalCol >= param.vOffset) {
        uint row = globalCol - param.vOffset;
        uint kvHead = gl_WorkGroupID.x - param.vOffset / TS;
        quantizeParams(acc);
        vCache[cacheSlot + row] = uint8_t(quantize(acc));
        if (gl_LocalInvocationID.x == 0) {
            vScale[kvHead * (pos + 1u) + pos] = qscale_sh;
            vZero[kvHead * (pos + 1u) + pos] = qzero_sh;
        }
        return;
    }

    acc_shared[col] = acc;
    barrier();

    if (gl_LocalInvocationID.x == 0) {
        float final_sum = 0.0;
        for (uint i = 0; i < TS; i++) {
            final_sum += acc_shared[i] * acc_shared[i];
        }
        shared_sum2 = final_sum;
    }
    barrier();
    float rms2 = sqrt((shared_sum2 / float(HEAD_DIM)) + EPSILON);
    float inv_rms2 = 1.0 / rms2;

    float normGamma = (globalCol < param.gOffset) ? qGamma[col] : kGamma[col];
    rope_shared[col] = acc * inv_rms2 * normGamma;
    barrier();

    if (col < ROTARY_DIM) {
        float angle = float(pos) * theta[col & (ROTARY_HALF - 1u)];
        float cos_a = cos(angle);
        float sin_a = sin(angle);
        if (col < ROTARY_HALF) {
            acc = rope_shared[col] * cos_a - rope_shared[col + ROTARY_HALF] * sin_a;
        } else {
            acc = rope_shared[col - ROTARY_HALF] * sin_a + rope_shared[col] * cos_a;
        }
    } else {
        acc = rope_shared[col];
    }

    if (globalCol < param.kOffset) {
        qOut[globalCol] = acc * inversesqrt(float(HEAD_DIM));
    } else {
        uint row = globalCol - param.kOffset;
        uint kvHead = gl_WorkGroupID.x - param.kOffset / TS;
        quantizeParams(acc);
        kCache[cacheSlot + row] = uint8_t(quantize(acc));
        if (gl_LocalInvocationID.x == 0) {
            kScale[kvHead * (pos + 1u) + pos] = qscale_sh;
            kZero[kvHead * (pos + 1u) + pos] = qzero_sh;
        }
    }
}
