#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_shader_atomic_float : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#define TS 256
#define vec 4
layout(constant_id = 0) const int d_model = 4096;

layout(local_size_x = TS, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Dimensions {
    uint M;
    uint N;
    uint K;
    uint gOffset;
    uint kOffset;
    uint vOffset;
    uint maxCtx;
    uint headDim;
    uint rotaryDim;
} param;

const float EPSILON = 1e-6;

layout(set = 0, binding = 0) buffer DataBuffer { vec4 x[]; };
layout(set = 0, binding = 1) readonly buffer GammaBuffer { vec4 gamma[]; };
layout(set = 0, binding = 2) readonly buffer weightBuffer { uvec4 w[]; };
layout(set = 0, binding = 3) readonly buffer thetaBuffer { float theta[]; };
layout(set = 0, binding = 4) buffer qOutBuffer { float qOut[]; };
layout(set = 0, binding = 5) buffer kCacheBuffer { uint16_t kCache[]; };
layout(set = 0, binding = 6) buffer vCacheBuffer { uint16_t vCache[]; };
layout(set = 0, binding = 7) buffer PositionBuffer { uint position[]; };
layout(set = 0, binding = 8) readonly buffer qGammaBuffer { float qGamma[]; };
layout(set = 0, binding = 9) readonly buffer kGammaBuffer { float kGamma[]; };
layout(set = 0, binding = 10) buffer gAttnBuffer { float gAttn[]; };

shared float shared_sum;
shared vec4 cache[d_model/vec];
shared float sub_sums[(TS + 31) / 32];
shared float acc_shared[TS];
shared float rope_shared[TS];
shared float shared_sum2;

void main() {
    uint col = gl_LocalInvocationID.x;
    uint globalCol = gl_WorkGroupID.x*TS + col;
    uint pos = position[0];
    uint HEAD_DIM = param.headDim;
    uint ROTARY_DIM = param.rotaryDim;
    uint ROTARY_HALF = ROTARY_DIM / 2u;
    uint MAXCTX = param.maxCtx;
    if (globalCol >= param.N) return;

    float sum_sq = 0.0;

    for (uint t = 0; t < param.K/vec; t+=TS) {
        uint idx = t + col;
        vec4 val = x[idx];
        cache[idx] = val * gamma[idx];
        sum_sq += dot(val, val);
    }

    sum_sq = subgroupAdd(sum_sq);
    if (subgroupElect()) {
        sub_sums[gl_SubgroupID] = sum_sq;
    }
    barrier();

    if (gl_LocalInvocationID.x == 0) {
        float final_sum = 0.0;
        uint active_subgroups = (TS + gl_SubgroupSize - 1) / gl_SubgroupSize;
        for (uint i = 0; i < active_subgroups; i++) {
            final_sum += sub_sums[i];
        }
        shared_sum = final_sum;
    }
    barrier();
    float rms = sqrt((shared_sum / float(d_model)) + EPSILON);
    float inv_rms = 1.0 / rms;

    float acc = 0.0;
    uint baseRow = 0;
    #pragma unroll
    for (uint k=0;k<param.K/vec; k+=2) {
        uvec4 rawInput = w[baseRow + globalCol];
        vec4 outVectorA = vec4(unpackHalf2x16(rawInput.x), unpackHalf2x16(rawInput.y));
        vec4 outVectorB = vec4(unpackHalf2x16(rawInput.z), unpackHalf2x16(rawInput.w));
        acc += dot(cache[k] * inv_rms, outVectorA);
        acc += dot(cache[k+1] * inv_rms, outVectorB);
        baseRow += param.N;
    }

    uint cacheSlot = pos * (param.vOffset - param.kOffset);

    if (globalCol >= param.vOffset) {
        uint row = globalCol - param.vOffset;
        vCache[cacheSlot + row] = uint16_t(packHalf2x16(vec2(acc)));
        return;
    }
    if (globalCol >= param.gOffset && globalCol < param.kOffset) {
        gAttn[globalCol - param.gOffset] = acc;
        return;
    }

    acc_shared[col] = acc;
    barrier();

    if (gl_LocalInvocationID.x == 0) {
        float final_sum = 0.0;
        for (uint i = 0; i < TS; i++) {
            final_sum += acc_shared[i] * acc_shared[i];
        }
        shared_sum2 = final_sum;
    }
    barrier();
    float rms2 = sqrt((shared_sum2 / float(HEAD_DIM)) + EPSILON);
    float inv_rms2 = 1.0 / rms2;

    float normGamma = (globalCol < param.gOffset) ? qGamma[col] : kGamma[col];
    rope_shared[col] = acc * inv_rms2 * normGamma;
    barrier();

    if (col < ROTARY_DIM) {
        float angle = float(pos) * theta[col & (ROTARY_HALF - 1u)];
        float cos_a = cos(angle);
        float sin_a = sin(angle);
        if (col < ROTARY_HALF) {
            acc = rope_shared[col] * cos_a - rope_shared[col + ROTARY_HALF] * sin_a;
        } else {
            acc = rope_shared[col - ROTARY_HALF] * sin_a + rope_shared[col] * cos_a;
        }
    } else {
        acc = rope_shared[col];
    }

    if (globalCol < param.kOffset) {
        qOut[globalCol] = acc * inversesqrt(float(HEAD_DIM));
    } else {
        uint row = globalCol - param.kOffset;
        kCache[cacheSlot + row] = uint16_t(packHalf2x16(vec2(acc)));
    }
}
