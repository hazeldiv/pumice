#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#define TS 256

layout(local_size_x = TS, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint N;
    uint gOffset;
    uint kOffset;
    uint vOffset;
    uint tokBase;
    uint maxCtx;
    uint headDim;
    uint rotaryDim;
    uint heads;
    uint kvHeads;
} param;

layout(set = 0, binding = 0) readonly restrict buffer RawBuffer { float raw[]; };
layout(set = 0, binding = 1) buffer qOutBuffer { float qOut[]; };
layout(set = 0, binding = 2) buffer kCacheBuffer { uint16_t kCache[]; };
layout(set = 0, binding = 3) buffer vCacheBuffer { uint16_t vCache[]; };
layout(set = 0, binding = 4) readonly restrict buffer thetaBuffer { float theta[]; };
layout(set = 0, binding = 5) readonly restrict buffer qGammaBuffer { float qGamma[]; };
layout(set = 0, binding = 6) readonly restrict buffer kGammaBuffer { float kGamma[]; };
layout(set = 0, binding = 7) buffer gAttnBuffer { float gAttn[]; };

shared float acc_shared[TS];
shared float rope_shared[TS];
shared float shared_sum2;

const float EPSILON = 1e-6;

void main() {
    uint HEAD_DIM = param.headDim;
    uint ROTARY_DIM = param.rotaryDim;
    uint ROTARY_HALF = ROTARY_DIM / 2u;
    uint MAXCTX = param.maxCtx;
    uint col = gl_LocalInvocationID.x;
    uint head = gl_WorkGroupID.x;
    uint row = gl_WorkGroupID.y;
    uint globalCol = head * HEAD_DIM + col;
    uint token = param.tokBase + row;
    uint cacheSlot = token * (param.vOffset - param.kOffset);

    uint qHeads = param.gOffset / HEAD_DIM;
    uint gHeads = (param.kOffset - param.gOffset) / HEAD_DIM;
    uint kHeadBase = qHeads + gHeads;
    uint vHeadBase = kHeadBase + (param.vOffset - param.kOffset) / HEAD_DIM;

    float acc = raw[row * param.N + globalCol];

    if (head >= vHeadBase) {
        vCache[cacheSlot + (globalCol - param.vOffset)] = uint16_t(packHalf2x16(vec2(acc)));
        return;
    }
    if (head >= kHeadBase) {
        acc_shared[col] = acc;
        barrier();
        if (col == 0) {
            float final_sum = 0.0;
            for (uint i = 0; i < TS; i++) {
                final_sum += acc_shared[i] * acc_shared[i];
            }
            shared_sum2 = final_sum;
        }
        barrier();
        float inv_rms2 = 1.0 / sqrt((shared_sum2 / float(HEAD_DIM)) + EPSILON);
        rope_shared[col] = acc * inv_rms2 * kGamma[col];
        barrier();
        if (col < ROTARY_DIM) {
            float angle = float(token) * theta[col & (ROTARY_HALF - 1u)];
            float cos_a = cos(angle);
            float sin_a = sin(angle);
            if (col < ROTARY_HALF) {
                acc = rope_shared[col] * cos_a - rope_shared[col + ROTARY_HALF] * sin_a;
            } else {
                acc = rope_shared[col - ROTARY_HALF] * sin_a + rope_shared[col] * cos_a;
            }
        } else {
            acc = rope_shared[col];
        }
        kCache[(globalCol - param.kOffset) * MAXCTX + token] = uint16_t(packHalf2x16(vec2(acc)));
        return;
    }
    if (head >= qHeads) {
        gAttn[row * param.gOffset + (head - qHeads) * HEAD_DIM + col] = acc;
        return;
    }

    acc_shared[col] = acc;
    barrier();

    if (col == 0) {
        float final_sum = 0.0;
        for (uint i = 0; i < TS; i++) {
            final_sum += acc_shared[i] * acc_shared[i];
        }
        shared_sum2 = final_sum;
    }
    barrier();
    float inv_rms2 = 1.0 / sqrt((shared_sum2 / float(HEAD_DIM)) + EPSILON);

    rope_shared[col] = acc * inv_rms2 * qGamma[col];
    barrier();

    if (col < ROTARY_DIM) {
        float angle = float(token) * theta[col & (ROTARY_HALF - 1u)];
        float cos_a = cos(angle);
        float sin_a = sin(angle);
        if (col < ROTARY_HALF) {
            acc = rope_shared[col] * cos_a - rope_shared[col + ROTARY_HALF] * sin_a;
        } else {
            acc = rope_shared[col - ROTARY_HALF] * sin_a + rope_shared[col] * cos_a;
        }
    } else {
        acc = rope_shared[col];
    }

    qOut[row * param.gOffset + globalCol] = acc * inversesqrt(float(HEAD_DIM));
}
