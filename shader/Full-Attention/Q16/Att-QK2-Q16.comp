#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#define TS 16
#define TN 64
#define NEG_INF -1e30

layout(local_size_x = TS, local_size_y = TS, local_size_z = 1) in;

layout(push_constant) uniform P { uint ctxLen; uint qOff; uint mRows; uint headBase; uint maxCtx; uint kvHeads; uint qDim; uint kvRows; uint gqa; } param;

layout(set = 0, binding = 0) readonly restrict buffer Q { vec4 query[]; };
layout(set = 0, binding = 1) readonly restrict buffer K { uint16_t key[]; };
layout(set = 0, binding = 2) writeonly restrict buffer S { float16_t s[]; };

shared vec4 Asub[4][TS];
shared vec4 Bsub[4][TN];

void main() {
    uint HEAD_DIM = 256u;
    uint KV_HEADS = param.kvHeads;
    uint Q_DIM = param.qDim;
    uint MAXCTX = param.maxCtx;
    uint row = gl_LocalInvocationID.y;
    uint col = gl_LocalInvocationID.x;
    uint tid = row * TS + col;
    uint mtile = gl_WorkGroupID.y % (param.mRows / TS);
    uint hL = gl_WorkGroupID.y / (param.mRows / TS);
    uint head = param.headBase + hL;
    uint kvh = head / param.gqa;
    uint mGlobal = mtile * TS + row;
    uint nBase = gl_WorkGroupID.x * TN;
    uint limit = param.qOff + mGlobal;

    float acc0 = 0.0;
    float acc1 = 0.0;
    float acc2 = 0.0;
    float acc3 = 0.0;

    bool inRange = (nBase + col * 4) <= limit;

    for (uint c = 0; c < HEAD_DIM / TS; c++) {
        if (tid < 64) {
            uint m = tid / 4;
            uint kv = tid % 4;
            Asub[kv][m] = query[(mtile * TS + m) * (Q_DIM / 4) + head * (HEAD_DIM / 4) + c * 4 + kv];
        }
        if (tid < 64) {
            uint tok = nBase + tid;
            uint base = (kvh * HEAD_DIM + c * 16) * MAXCTX + tok;
            Bsub[0][tid] = vec4(unpackHalf2x16(uint(key[base]) | (uint(key[base + MAXCTX]) << 16)), unpackHalf2x16(uint(key[base + 2 * MAXCTX]) | (uint(key[base + 3 * MAXCTX]) << 16)));
            Bsub[1][tid] = vec4(unpackHalf2x16(uint(key[base + 4 * MAXCTX]) | (uint(key[base + 5 * MAXCTX]) << 16)), unpackHalf2x16(uint(key[base + 6 * MAXCTX]) | (uint(key[base + 7 * MAXCTX]) << 16)));
            Bsub[2][tid] = vec4(unpackHalf2x16(uint(key[base + 8 * MAXCTX]) | (uint(key[base + 9 * MAXCTX]) << 16)), unpackHalf2x16(uint(key[base + 10 * MAXCTX]) | (uint(key[base + 11 * MAXCTX]) << 16)));
            Bsub[3][tid] = vec4(unpackHalf2x16(uint(key[base + 12 * MAXCTX]) | (uint(key[base + 13 * MAXCTX]) << 16)), unpackHalf2x16(uint(key[base + 14 * MAXCTX]) | (uint(key[base + 15 * MAXCTX]) << 16)));
        }
        barrier();
        #pragma unroll
        for (uint kv = 0; kv < 4; kv++) {
            vec4 a = Asub[kv][row];
            acc0 += dot(a, Bsub[kv][col * 4]);
            acc1 += dot(a, Bsub[kv][col * 4 + 1]);
            acc2 += dot(a, Bsub[kv][col * 4 + 2]);
            acc3 += dot(a, Bsub[kv][col * 4 + 3]);
        }
        barrier();
    }

    uint n0 = nBase + col * 4;
    uint pRow = (hL * param.mRows + mGlobal) * MAXCTX;
    if (!inRange) {
        s[pRow + n0]     = float16_t(NEG_INF);
        s[pRow + n0 + 1] = float16_t(NEG_INF);
        s[pRow + n0 + 2] = float16_t(NEG_INF);
        s[pRow + n0 + 3] = float16_t(NEG_INF);
        return;
    }
    #pragma unroll
    for (uint j = 0; j < 4; j++) {
        uint tok = n0 + j;
        float v = NEG_INF;
        if (tok <= limit) {
            float raw = (j == 0) ? acc0 : (j == 1) ? acc1 : (j == 2) ? acc2 : acc3;
            v = raw;
        }
        s[pRow + tok] = float16_t(v);
    }
}