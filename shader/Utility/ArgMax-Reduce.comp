#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable
#define TS 1024
#define MAX_PENALTY 1024
#define PEN_WORDS 8192
#define BISECT 28

layout(local_size_x = TS, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint vocabSize;
    uint doIncrement;
    uint passIdx;
    uint mode;
} params;

layout(set = 0, binding = 0) readonly restrict buffer MaxValueBuffer { float maxValue[]; };
layout(set = 0, binding = 1) readonly restrict buffer MaxIndexBuffer { uint maxIndex[]; };
layout(set = 0, binding = 2) buffer LogitsBuffer { vec4 logits[]; };
layout(set = 0, binding = 3) readonly restrict buffer SamplerParamsBuffer {
    float temperature;
    float repPenalty;
    uint penaltyLength;
    uint topK;
    float topP;
    float minP;
    float presencePenalty;
} sp;
layout(set = 0, binding = 4) buffer HistoryBuffer { uint history[]; };
layout(set = 0, binding = 5) buffer RngBuffer { uint rng[]; };
layout(set = 0, binding = 6) writeonly restrict buffer ResultBuffer { uint result[]; };
layout(set = 0, binding = 7) buffer PositionBuffer { uint position[]; };
layout(set = 0, binding = 8) writeonly restrict buffer TokenIdsBuffer { uint tokenIds[]; };

shared float redVal[TS];
shared uint redIdx[TS];
shared float blockSum[TS];
shared float cumBase[TS];
shared uint penBits[PEN_WORDS];
shared float subSum[(TS + 31) / 32];
shared uint subCnt[(TS + 31) / 32];
shared float allSum;
shared uint allCnt;
shared float gThrP;
shared float gTarget;
shared uint winBlock;
shared uint outTok;

uint base4;
uint cnt4;
float mySum;
float myMax;
float myMin;

uint xorshift32(uint x) {
    x ^= x << 13u;
    x ^= x >> 17u;
    x ^= x << 5u;
    return x;
}

float maxAll(float v, uint tid) {
    v = subgroupMax(v);
    if (subgroupElect()) subSum[gl_SubgroupID] = v;
    barrier();
    if (tid == 0u) {
        uint ns = (TS + gl_SubgroupSize - 1u) / gl_SubgroupSize;
        float t = subSum[0];
        for (uint i = 1u; i < ns; i++) t = max(t, subSum[i]);
        allSum = t;
    }
    barrier();
    return allSum;
}

float minAll(float v, uint tid) {
    v = subgroupMin(v);
    if (subgroupElect()) subSum[gl_SubgroupID] = v;
    barrier();
    if (tid == 0u) {
        uint ns = (TS + gl_SubgroupSize - 1u) / gl_SubgroupSize;
        float t = subSum[0];
        for (uint i = 1u; i < ns; i++) t = min(t, subSum[i]);
        allSum = t;
    }
    barrier();
    return allSum;
}

float sumAll(float v, uint tid) {
    v = subgroupAdd(v);
    if (subgroupElect()) subSum[gl_SubgroupID] = v;
    barrier();
    if (tid == 0u) {
        uint ns = (TS + gl_SubgroupSize - 1u) / gl_SubgroupSize;
        float t = 0.0f;
        for (uint i = 0u; i < ns; i++) t += subSum[i];
        allSum = t;
    }
    barrier();
    return allSum;
}

uint countAll(uint c, uint tid) {
    c = subgroupAdd(c);
    if (subgroupElect()) subCnt[gl_SubgroupID] = c;
    barrier();
    if (tid == 0u) {
        uint ns = (TS + gl_SubgroupSize - 1u) / gl_SubgroupSize;
        uint t = 0u;
        for (uint i = 0u; i < ns; i++) t += subCnt[i];
        allCnt = t;
    }
    barrier();
    return allCnt;
}

float massAbove(float thr) {
    if (myMax < thr) return 0.0f;
    if (myMin >= thr) return mySum;
    float s = 0.0f;
    for (uint k = 0u; k < cnt4; k++) {
        vec4 p = logits[base4 + k];
        s += (p.x >= thr ? p.x : 0.0f) + (p.y >= thr ? p.y : 0.0f);
        s += (p.z >= thr ? p.z : 0.0f) + (p.w >= thr ? p.w : 0.0f);
    }
    return s;
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint V = params.vocabSize;

    if (params.mode == 0u) {
        uint numGroups = (V + 255u) / 256u;
        float bestValue = uintBitsToFloat(0xFF800000u);
        uint bestIndex = 0u;
        for (uint i = tid; i < numGroups; i += TS) {
            float v = maxValue[i];
            uint idx = maxIndex[i];
            if (v > bestValue || (v == bestValue && idx < bestIndex)) {
                bestValue = v;
                bestIndex = idx;
            }
        }
        redVal[tid] = bestValue;
        redIdx[tid] = bestIndex;
        barrier();
        for (uint stride = TS / 2u; stride > 0u; stride >>= 1u) {
            if (tid < stride) {
                float ov = redVal[tid + stride];
                uint oi = redIdx[tid + stride];
                if (ov > redVal[tid] || (ov == redVal[tid] && oi < redIdx[tid])) {
                    redVal[tid] = ov;
                    redIdx[tid] = oi;
                }
            }
            barrier();
        }
        if (tid == 0u) {
            result[params.passIdx] = redIdx[0];
            tokenIds[0] = redIdx[0];
            if (params.doIncrement == 1u) position[0] = position[0] + 1u;
        }
        return;
    }

    uint V4 = (V + 3u) / 4u;
    uint E4 = (V4 + TS - 1u) / TS;
    base4 = tid * E4;
    cnt4 = 0u;
    if (base4 < V4) cnt4 = min(E4, V4 - base4);

    float penalty = sp.repPenalty;
    float pres = sp.presencePenalty * (1.0f / sp.temperature);
    uint penLen = sp.penaltyLength;
    if (penLen > MAX_PENALTY) penLen = MAX_PENALTY;
    uint topK = sp.topK;
    if (topK > V) topK = V;
    float topP = sp.topP;
    bool doPen = (penLen > 0u) && (penalty != 1.0f || pres != 0.0f);
    float invT = 1.0f / sp.temperature;

    if (doPen) {
        for (uint i = tid; i < PEN_WORDS; i += TS) penBits[i] = 0u;
        barrier();
        if (tid < penLen) {
            uint id = history[tid];
            if (id < PEN_WORDS * 32u) atomicOr(penBits[id >> 5u], 1u << (id & 31u));
        }
        barrier();
    }

    float lmax = -3.4e38f;
    float lmin = 3.4e38f;
    for (uint k = 0u; k < cnt4; k++) {
        uint j = base4 * 4u + k * 4u;
        vec4 t = logits[base4 + k] * invT;
        if (doPen) {
            uint bits = (penBits[j >> 5u] >> (j & 31u)) & 0xFu;
            if ((bits & 1u) != 0u) {
                if (penalty != 1.0f) t.x = (t.x > 0.0f) ? (t.x / penalty) : (t.x * penalty);
                t.x -= pres;
            }
            if ((bits & 2u) != 0u) {
                if (penalty != 1.0f) t.y = (t.y > 0.0f) ? (t.y / penalty) : (t.y * penalty);
                t.y -= pres;
            }
            if ((bits & 4u) != 0u) {
                if (penalty != 1.0f) t.z = (t.z > 0.0f) ? (t.z / penalty) : (t.z * penalty);
                t.z -= pres;
            }
            if ((bits & 8u) != 0u) {
                if (penalty != 1.0f) t.w = (t.w > 0.0f) ? (t.w / penalty) : (t.w * penalty);
                t.w -= pres;
            }
        }
        if (j + 1u >= V) t.y = -3.4e38f;
        if (j + 2u >= V) t.z = -3.4e38f;
        if (j + 3u >= V) t.w = -3.4e38f;
        logits[base4 + k] = t;
        lmax = max(lmax, max(max(t.x, t.y), max(t.z, t.w)));
        lmin = min(lmin, min(min(t.x, t.y), min(t.z, t.w)));
    }
    float gMax = maxAll(lmax, tid);
    float gMin = minAll(lmin, tid);

    mySum = 0.0f;
    myMax = 0.0f;
    myMin = 1.0f;
    for (uint k = 0u; k < cnt4; k++) {
        vec4 p = exp(logits[base4 + k] - gMax);
        logits[base4 + k] = p;
        mySum += (p.x + p.y) + (p.z + p.w);
        myMax = max(myMax, max(max(p.x, p.y), max(p.z, p.w)));
        myMin = min(myMin, min(min(p.x, p.y), min(p.z, p.w)));
    }
    float Zall = sumAll(mySum, tid);

    if (tid == 0u) gThrP = 0.0f;
    barrier();

    if (topK > 0u) {
        float gLo = gMin;
        float gHi = gMax;
        for (uint it = 0u; it < BISECT; it++) {
            if (tid == 0u) gThrP = exp(0.5f * (gLo + gHi) - gMax);
            barrier();
            uint c = 0u;
            if (myMax >= gThrP) {
                for (uint k = 0u; k < cnt4; k++) {
                    vec4 p = logits[base4 + k];
                    c += (p.x >= gThrP ? 1u : 0u) + (p.y >= gThrP ? 1u : 0u);
                    c += (p.z >= gThrP ? 1u : 0u) + (p.w >= gThrP ? 1u : 0u);
                }
            }
            uint total = countAll(c, tid);
            if (tid == 0u) {
                float mid = 0.5f * (gLo + gHi);
                if (total >= topK) gLo = mid; else gHi = mid;
            }
            barrier();
        }
        if (tid == 0u) gThrP = exp(gLo - gMax);
        barrier();
    }

    if (topP < 1.0f && topP > 0.0f) {
        float Zk = Zall;
        float gLo = gMin;
        float gHi = gMax;
        if (topK > 0u) Zk = sumAll(massAbove(gThrP), tid);
        if (tid == 0u) allSum = topP * Zk;
        barrier();
        float target = allSum;
        for (uint it = 0u; it < BISECT; it++) {
            if (tid == 0u) gThrP = exp(0.5f * (gLo + gHi) - gMax);
            barrier();
            float s = sumAll(massAbove(gThrP), tid);
            if (tid == 0u) {
                float mid = 0.5f * (gLo + gHi);
                if (s >= target) gLo = mid; else gHi = mid;
            }
            barrier();
        }
        if (tid == 0u) gThrP = exp(gLo - gMax);
        barrier();
    }

    if (sp.minP > 0.0f) {
        if (tid == 0u && gThrP < sp.minP) gThrP = sp.minP;
        barrier();
    }

    blockSum[tid] = massAbove(gThrP);
    barrier();

    if (tid == 0u) {
        float acc = 0.0f;
        for (uint i = 0u; i < TS; i++) { cumBase[i] = acc; acc += blockSum[i]; }
        uint s = rng[0];
        if (s == 0u) s = 0x9E3779B9u;
        float u = float(s >> 8) * (1.0f / 16777216.0f);
        gTarget = u * acc;
        winBlock = TS - 1u;
        for (uint i = 0u; i < TS; i++) {
            if (gTarget < cumBase[i] + blockSum[i]) { winBlock = i; break; }
        }
    }
    barrier();

    if (tid == winBlock) {
        float acc = cumBase[tid];
        uint chosen = base4 * 4u;
        bool found = false;
        for (uint k = 0u; k < cnt4; k++) {
            vec4 p = logits[base4 + k];
            uint j = base4 * 4u + k * 4u;
            if (!found && j < V && p.x >= gThrP) { acc += p.x; chosen = j; if (gTarget < acc) found = true; }
            if (!found && j + 1u < V && p.y >= gThrP) { acc += p.y; chosen = j + 1u; if (gTarget < acc) found = true; }
            if (!found && j + 2u < V && p.z >= gThrP) { acc += p.z; chosen = j + 2u; if (gTarget < acc) found = true; }
            if (!found && j + 3u < V && p.w >= gThrP) { acc += p.w; chosen = j + 3u; if (gTarget < acc) found = true; }
        }
        outTok = chosen;
    }
    barrier();

    if (tid == 0u) {
        result[params.passIdx] = outTok;
        tokenIds[0] = outTok;
        uint pos = position[0];
        if (penLen > 0u) history[pos % penLen] = outTok;
        uint s = rng[0];
        if (s == 0u) s = 0x9E3779B9u;
        rng[0] = xorshift32(s);
        if (params.doIncrement == 1u) position[0] = pos + 1u;
    }
}
