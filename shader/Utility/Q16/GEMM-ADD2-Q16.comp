#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#define TS 16
#define TN 32
#define vec 4

layout(local_size_x = TS, local_size_y = TS, local_size_z = 1) in;

layout(push_constant) uniform Dimensions { uint M; uint N; uint K; } dims;

layout(set = 0, binding = 0) readonly restrict buffer MatrixA { vec4 A[]; };
layout(set = 0, binding = 1) readonly restrict buffer MatrixB { uvec4 B[]; };
layout(set = 0, binding = 2) writeonly restrict buffer MatrixC { float C[]; };
layout(set = 0, binding = 3) readonly restrict buffer MatrixR { float R[]; };

shared vec4 Asub[2][4][TS];
shared vec4 Bsub[2][4][TN];

void loadTiles(uint t, uint buf, uint tid) {
    if (tid < 64) {
        uint m = tid / 4;
        uint kv = tid % 4;
        Asub[buf][kv][m] = A[(gl_WorkGroupID.y * TS + m) * (dims.K / vec) + t * 4 + kv];
    }
    if (tid < 64) {
        uint block = tid / 32;
        uint c = tid % 32;
        uvec4 raw = B[(t * 2 + block) * dims.N + gl_WorkGroupID.x * TN + c];
        Bsub[buf][block * 2][c]     = vec4(unpackHalf2x16(raw.x), unpackHalf2x16(raw.y));
        Bsub[buf][block * 2 + 1][c] = vec4(unpackHalf2x16(raw.z), unpackHalf2x16(raw.w));
    }
}

void main() {
    uint row = gl_LocalInvocationID.y;
    uint col = gl_LocalInvocationID.x;
    uint tid = row * TS + col;
    uint mGlobal = gl_WorkGroupID.y * TS + row;
    uint nBase = gl_WorkGroupID.x * TN;

    float acc0 = 0.0;
    float acc1 = 0.0;

    uint numTiles = dims.K / TS;
    loadTiles(0, 0u, tid);
    barrier();
    for (uint t = 0; t < numTiles; t++) {
        uint cur = t & 1u;
        if (t + 1 < numTiles) loadTiles(t + 1, cur ^ 1u, tid);
        #pragma unroll
        for (uint kv = 0; kv < 4; kv++) {
            vec4 a = Asub[cur][kv][row];
            acc0 += dot(a, Bsub[cur][kv][col * 2]);
            acc1 += dot(a, Bsub[cur][kv][col * 2 + 1]);
        }
        barrier();
    }

    uint n0 = nBase + col * 2;
    C[mGlobal * dims.N + n0]     = acc0 + R[mGlobal * dims.N + n0];
    C[mGlobal * dims.N + n0 + 1] = acc1 + R[mGlobal * dims.N + n0 + 1];
}
