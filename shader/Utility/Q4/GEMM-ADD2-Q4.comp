#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#define TS 16
#define TN 64
#define vec 4

layout(local_size_x = TS, local_size_y = TS, local_size_z = 1) in;

layout(push_constant) uniform Dimensions { uint M; uint N; uint K; } dims;

layout(set = 0, binding = 0) readonly restrict buffer MatrixA { vec4 A[]; };
layout(set = 0, binding = 1) readonly restrict buffer MatrixB { uvec4 B[]; };
layout(set = 0, binding = 2) writeonly restrict buffer MatrixC { float C[]; };
layout(set = 0, binding = 3) readonly restrict buffer MatrixD { vec4 scale[]; };
layout(set = 0, binding = 4) readonly restrict buffer MatrixE { vec4 zeroPoint[]; };
layout(set = 0, binding = 5) readonly restrict buffer MatrixR { float R[]; };

shared vec4 Asub[2][4][TS];
shared vec4 Bsub[2][4][TN];

const uvec4 lowShifts  = uvec4(0, 4, 8, 12);
const uvec4 highShifts = uvec4(16, 20, 24, 28);

vec4 unpackInt4x4(uint packedComponent, uvec4 shiftOffsets) {
    return vec4(uvec4(packedComponent) >> shiftOffsets & uvec4(0xF));
}

void loadTiles(uint t, uint buf, uint tid, uint nBase, uint g) {
    if (tid < 64) {
        uint m = tid / 4;
        uint kv = tid % 4;
        Asub[buf][kv][m] = A[(gl_WorkGroupID.y * TS + m) * (dims.K / vec) + t * 4 + kv];
    }
    if (tid < 64) {
        uint c = tid;
        uvec4 raw = B[(t / 2) * dims.N + nBase + c];
        bool hi = ((t & 1) == 1);
        uint c0 = hi ? raw.z : raw.x;
        uint c1 = hi ? raw.w : raw.y;
        Bsub[buf][0][c] = unpackInt4x4(c0, lowShifts)  * scale[g*(dims.K/vec)+t*4+0] - zeroPoint[g*(dims.K/vec)+t*4+0];
        Bsub[buf][1][c] = unpackInt4x4(c0, highShifts) * scale[g*(dims.K/vec)+t*4+1] - zeroPoint[g*(dims.K/vec)+t*4+1];
        Bsub[buf][2][c] = unpackInt4x4(c1, lowShifts)  * scale[g*(dims.K/vec)+t*4+2] - zeroPoint[g*(dims.K/vec)+t*4+2];
        Bsub[buf][3][c] = unpackInt4x4(c1, highShifts) * scale[g*(dims.K/vec)+t*4+3] - zeroPoint[g*(dims.K/vec)+t*4+3];
    }
}

void main() {
    uint row = gl_LocalInvocationID.y;
    uint col = gl_LocalInvocationID.x;
    uint tid = row * TS + col;
    uint mGlobal = gl_WorkGroupID.y * TS + row;
    uint nBase = gl_WorkGroupID.x * TN;
    uint g = nBase / 256;

    float acc0 = 0.0;
    float acc1 = 0.0;
    float acc2 = 0.0;
    float acc3 = 0.0;

    uint numTiles = dims.K / TS;
    loadTiles(0, 0, tid, nBase, g);
    barrier();
    for (uint t = 0; t < numTiles; t++) {
        uint cur = t & 1u;
        if (t + 1 < numTiles) loadTiles(t + 1, cur ^ 1u, tid, nBase, g);
        #pragma unroll
        for (uint kv = 0; kv < 4; kv++) {
            vec4 a = Asub[cur][kv][row];
            acc0 += dot(a, Bsub[cur][kv][col * 4]);
            acc1 += dot(a, Bsub[cur][kv][col * 4 + 1]);
            acc2 += dot(a, Bsub[cur][kv][col * 4 + 2]);
            acc3 += dot(a, Bsub[cur][kv][col * 4 + 3]);
        }
        barrier();
    }

    uint n0 = nBase + col * 4;
    C[mGlobal * dims.N + n0]     = acc0 + R[mGlobal * dims.N + n0];
    C[mGlobal * dims.N + n0 + 1] = acc1 + R[mGlobal * dims.N + n0 + 1];
    C[mGlobal * dims.N + n0 + 2] = acc2 + R[mGlobal * dims.N + n0 + 2];
    C[mGlobal * dims.N + n0 + 3] = acc3 + R[mGlobal * dims.N + n0 + 3];
}
