#version 450
#define TS 256
#define vec 4
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = TS, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Dimensions {
    uint M;
    uint N;
    uint K;
    uint block;
} dims;

layout(set = 0, binding = 0) readonly restrict buffer PartialBuffer { vec4 PgPu[]; };
layout(set = 0, binding = 1) readonly restrict buffer MatrixB { uvec4 B[]; };
layout(set = 0, binding = 2) writeonly restrict buffer PartialOutBuffer { float P[]; };
layout(set = 0, binding = 3) readonly restrict buffer MatrixD { uvec2 scale[]; };
layout(set = 0, binding = 4) readonly restrict buffer MatrixE { uvec2 zeroPoint[]; };

shared vec4 asSub[2][TS];
shared float sub_sums[(TS + 31) / 32];

vec4 unpackInt4x4(uint packedComponent) {
    return vec4(uvec4(bitfieldExtract(packedComponent, 0, 4),
                      bitfieldExtract(packedComponent, 4, 4),
                      bitfieldExtract(packedComponent, 8, 4),
                      bitfieldExtract(packedComponent, 12, 4)));
}

vec4 unpackInt4x4High(uint packedComponent) {
    return vec4(uvec4(bitfieldExtract(packedComponent, 16, 4),
                      bitfieldExtract(packedComponent, 20, 4),
                      bitfieldExtract(packedComponent, 24, 4),
                      bitfieldExtract(packedComponent, 28, 4)));
}

vec4 unpackFp16x4(uvec2 v) {
    return vec4(unpackHalf2x16(v.x), unpackHalf2x16(v.y));
}

vec4 loadAct(uint idx) {
    vec4 g = vec4(0.0);
    vec4 u = vec4(0.0);
    for (uint z = 0; z < 4u; z++) {
        g += PgPu[z * dims.K / vec + idx];
        u += PgPu[(4u + z) * dims.K / vec + idx];
    }
    return (g / (vec4(1.0) + exp2(-g * 1.44269504))) * u;
}

void main() {
    uint col = gl_LocalInvocationID.x;
    uint chunk = gl_WorkGroupID.y;
    uint globalCol = gl_WorkGroupID.x*TS + col;
    if (globalCol >= dims.N) return;
    uint blockBase = (globalCol / dims.block) * (dims.K / vec);

    float ztot = 0.0;
    float acc = 0.0;
    uint numTiles = (dims.K + TS - 1) / TS / vec;

    if (dims.block >= TS) {
        uint scaleIdx = blockBase + col;
        if (chunk < numTiles) {
            vec4 act = loadAct(chunk*TS + col);
            asSub[0][col] = act * unpackFp16x4(scale[chunk*TS + scaleIdx]);
            float zp = subgroupAdd(dot(act * unpackFp16x4(zeroPoint[chunk*TS + scaleIdx]), vec4(1.0)));
            if (subgroupElect()) {
                sub_sums[gl_SubgroupID] = zp;
            }
        }
        barrier();
        if (chunk < numTiles) {
            for (uint i = 0; i < gl_NumSubgroups; i++) ztot += sub_sums[i];
        }

        uint it = 0;
        for (uint t = chunk; t < numTiles; t += 4u) {
            uint cur = it & 1, nxt = (it+1) & 1;
            uint nextTile = t + 4u;
            if (nextTile < numTiles) {
                vec4 act = loadAct(nextTile*TS + col);
                asSub[nxt][col] = act * unpackFp16x4(scale[nextTile*TS + scaleIdx]);
                float zp = subgroupAdd(dot(act * unpackFp16x4(zeroPoint[nextTile*TS + scaleIdx]), vec4(1.0)));
                if (subgroupElect()) {
                    sub_sums[gl_SubgroupID] = zp;
                }
            }
            barrier();
            if (nextTile < numTiles) {
                for (uint i = 0; i < gl_NumSubgroups; i++) ztot += sub_sums[i];
            }

            uint baseRow = t * (TS / 8) * dims.N;
            #pragma unroll
            for (uint k=0;k<TS; k+=8) {
                uvec4 rawInput = B[baseRow + globalCol];
                acc += dot(asSub[cur][k], unpackInt4x4(rawInput.x));
                acc += dot(asSub[cur][k+1], unpackInt4x4High(rawInput.x));
                acc += dot(asSub[cur][k+2], unpackInt4x4(rawInput.y));
                acc += dot(asSub[cur][k+3], unpackInt4x4High(rawInput.y));
                acc += dot(asSub[cur][k+4], unpackInt4x4(rawInput.z));
                acc += dot(asSub[cur][k+5], unpackInt4x4High(rawInput.z));
                acc += dot(asSub[cur][k+6], unpackInt4x4(rawInput.w));
                acc += dot(asSub[cur][k+7], unpackInt4x4High(rawInput.w));

                baseRow += dims.N;
            }

            barrier();
            it++;
        }
    } else {
        if (chunk < numTiles) {
            asSub[0][col] = loadAct(chunk*TS + col);
        }
        barrier();

        uint it = 0;
        for (uint t = chunk; t < numTiles; t += 4u) {
            uint cur = it & 1, nxt = (it+1) & 1;
            uint nextTile = t + 4u;
            if (nextTile < numTiles) {
                asSub[nxt][col] = loadAct(nextTile*TS + col);
            }
            barrier();

            uint baseRow = t * (TS / 8) * dims.N;
            uint kbase = t * TS;
            #pragma unroll
            for (uint k=0;k<TS; k+=8) {
                uvec4 rawInput = B[baseRow + globalCol];
                uvec2 sc[8];
                uvec2 zr[8];
                #pragma unroll
                for (uint i = 0; i < 8; i++) {
                    sc[i] = scale[blockBase + kbase + k + i];
                    zr[i] = zeroPoint[blockBase + kbase + k + i];
                }
                acc += dot(asSub[cur][k],   unpackInt4x4(rawInput.x)     * unpackFp16x4(sc[0]) - unpackFp16x4(zr[0]));
                acc += dot(asSub[cur][k+1], unpackInt4x4High(rawInput.x) * unpackFp16x4(sc[1]) - unpackFp16x4(zr[1]));
                acc += dot(asSub[cur][k+2], unpackInt4x4(rawInput.y)     * unpackFp16x4(sc[2]) - unpackFp16x4(zr[2]));
                acc += dot(asSub[cur][k+3], unpackInt4x4High(rawInput.y) * unpackFp16x4(sc[3]) - unpackFp16x4(zr[3]));
                acc += dot(asSub[cur][k+4], unpackInt4x4(rawInput.z)     * unpackFp16x4(sc[4]) - unpackFp16x4(zr[4]));
                acc += dot(asSub[cur][k+5], unpackInt4x4High(rawInput.z) * unpackFp16x4(sc[5]) - unpackFp16x4(zr[5]));
                acc += dot(asSub[cur][k+6], unpackInt4x4(rawInput.w)     * unpackFp16x4(sc[6]) - unpackFp16x4(zr[6]));
                acc += dot(asSub[cur][k+7], unpackInt4x4High(rawInput.w) * unpackFp16x4(sc[7]) - unpackFp16x4(zr[7]));

                baseRow += dims.N;
            }

            barrier();
            it++;
        }
    }

    P[chunk * dims.N + globalCol] = acc - ztot;
}
