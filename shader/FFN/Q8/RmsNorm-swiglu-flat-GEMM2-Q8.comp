#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#define TS 16
#define TN 32
#define vec 4

layout(local_size_x = TS, local_size_y = TS, local_size_z = 1) in;

layout(push_constant) uniform Dimensions { uint M; uint N; uint K; uint off; } dims;

layout(set = 0, binding = 0) readonly restrict buffer MatrixA { vec4 x[]; };
layout(set = 0, binding = 1) readonly restrict buffer MatrixB { vec4 gamma[]; };
layout(set = 0, binding = 2) readonly restrict buffer MatrixC { uvec4 gate[]; };
layout(set = 0, binding = 3) readonly restrict buffer MatrixD { uvec4 up[]; };
layout(set = 0, binding = 4) writeonly restrict buffer MatrixE { float gOut[]; };
layout(set = 0, binding = 5) writeonly restrict buffer MatrixF { float uOut[]; };
layout(set = 0, binding = 6) readonly restrict buffer MatrixG { vec4 scaleGate[]; };
layout(set = 0, binding = 7) readonly restrict buffer MatrixH { vec4 zeroPointGate[]; };
layout(set = 0, binding = 8) readonly restrict buffer MatrixI { vec4 scaleUp[]; };
layout(set = 0, binding = 9) readonly restrict buffer MatrixJ { vec4 zeroPointUp[]; };
layout(set = 0, binding = 10) readonly restrict buffer InvRms { float invRms[]; };

shared vec4 Asub[2][4][TS];
shared vec4 Bsub[2][4][TN];

vec4 unpackUint8x4(uint packedData) {
    uvec4 bytes = (uvec4(packedData) >> uvec4(0, 8, 16, 24)) & uvec4(0xFF);
    return vec4(bytes);
}

void loadTiles(uint t, uint buf, uint tid, uint lBase, uint upHalf, uint g, uint mRow0) {
    if (tid < 64) {
        uint m = tid / 4;
        uint kv = tid % 4;
        uint mg = mRow0 + m;
        Asub[buf][kv][m] = x[mg * (dims.K / vec) + t * 4 + kv] * gamma[t * 4 + kv] * invRms[mg];
    }
    if (tid < 32) {
        uint c = tid;
        uint sIdx = g * (dims.K / vec) + t * 4;
        if (upHalf == 0u) {
            uvec4 raw = gate[t * dims.N + lBase + c];
            Bsub[buf][0][c] = unpackUint8x4(raw.x) * scaleGate[sIdx] - zeroPointGate[sIdx];
            Bsub[buf][1][c] = unpackUint8x4(raw.y) * scaleGate[sIdx+1] - zeroPointGate[sIdx+1];
            Bsub[buf][2][c] = unpackUint8x4(raw.z) * scaleGate[sIdx+2] - zeroPointGate[sIdx+2];
            Bsub[buf][3][c] = unpackUint8x4(raw.w) * scaleGate[sIdx+3] - zeroPointGate[sIdx+3];
        } else {
            uvec4 raw = up[t * dims.N + lBase + c];
            Bsub[buf][0][c] = unpackUint8x4(raw.x) * scaleUp[sIdx] - zeroPointUp[sIdx];
            Bsub[buf][1][c] = unpackUint8x4(raw.y) * scaleUp[sIdx+1] - zeroPointUp[sIdx+1];
            Bsub[buf][2][c] = unpackUint8x4(raw.z) * scaleUp[sIdx+2] - zeroPointUp[sIdx+2];
            Bsub[buf][3][c] = unpackUint8x4(raw.w) * scaleUp[sIdx+3] - zeroPointUp[sIdx+3];
        }
    }
}

void main() {
    uint row = gl_LocalInvocationID.y;
    uint col = gl_LocalInvocationID.x;
    uint tid = row * TS + col;
    uint mGlobal = gl_WorkGroupID.y * TS + row;
    uint nBase = gl_WorkGroupID.x * TN;
    bool upHalf = nBase >= dims.off;
    uint lBase = nBase - (upHalf ? dims.off : 0u);
    uint g = lBase / 256;
    uint uh = upHalf ? 1u : 0u;
    uint mRow0 = gl_WorkGroupID.y * TS;

    float acc0 = 0.0;
    float acc1 = 0.0;

    uint numTiles = dims.K / TS;
    loadTiles(0, 0u, tid, lBase, uh, g, mRow0);
    barrier();
    for (uint t = 0; t < numTiles; t++) {
        uint cur = t & 1u;
        if (t + 1 < numTiles) loadTiles(t + 1, cur ^ 1u, tid, lBase, uh, g, mRow0);
        #pragma unroll
        for (uint kv = 0; kv < 4; kv++) {
            vec4 a = Asub[cur][kv][row];
            acc0 += dot(a, Bsub[cur][kv][col * 2]);
            acc1 += dot(a, Bsub[cur][kv][col * 2 + 1]);
        }
        barrier();
    }

    uint n0 = lBase + col * 2;
    if (!upHalf) {
        gOut[mGlobal * dims.N + n0]     = acc0;
        gOut[mGlobal * dims.N + n0 + 1] = acc1;
    } else {
        uOut[mGlobal * dims.N + n0]     = acc0;
        uOut[mGlobal * dims.N + n0 + 1] = acc1;
    }
}
